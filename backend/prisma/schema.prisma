datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model UserEntity {
  id            String       @id @default(uuid())
  login         String       @unique
  username      String
  email         String       @unique
  passwordHash  String       @map("password_hash")
  role          String       @default("USER")
  status        String       @default("ACTIVE")
  deactivatedAt DateTime?    @map("deactivated_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  profile       UserProfileEntity?

  @@map("users")
}

model UserProfileEntity {
  id                String      @id @default(uuid())
  userId            String      @unique @map("user_id")
  user              UserEntity  @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate         DateTime    @map("birth_date")
  weight            Float
  height            Float
  activityLevel     String      @map("activity_level")
  goal              String
  allergenIds       String[]    @map("allergen_ids")
  favoriteRecipeIds String[]    @map("favorite_recipe_ids")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model IngredientEntity {
  id               String  @id @default(uuid())
  name             String
  caloriesPer100g  Float   @map("calories_per_100g")
  proteinsPer100g  Float   @map("proteins_per_100g")
  fatsPer100g      Float   @map("fats_per_100g")
  carbsPer100g     Float   @map("carbs_per_100g")

  @@map("ingredients")
}

model RecipeEntity {
  id             String   @id @default(uuid())
  title          String
  description    String?
  servings       Float
  ingredients    Json
  imageUrl       String?  @map("image_url")
  mealTypes      String[] @map("meal_types")
  cookingMethod  String?  @map("cooking_method")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("recipes")
}